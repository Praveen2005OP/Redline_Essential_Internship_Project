{% doc %}
  @prompt
    Create a custom footer section that displays three columns side by side on desktop: 1) "Quick Links" menu column with links (Search, Home, About Us), 2) "Customer Support" menu column with links (Privacy and Policies, Return & Refund, Shipping Policy), and 3) "Stay in the Loop" newsletter signup column with a heading, a short description, an email input and subscribe button. For the newsletter form, use {% form 'contact' %} with input name="contact[email]" and a hidden input contact[tags] set to "newsletter". The footer should have a dark/black background with white text. Do NOT use any custom or invalid form types.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-menu-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-menu-item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.3s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-newsletter-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-newsletter-input-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-footer-newsletter-message-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
  }

  .ai-footer-newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-footer-newsletter-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-footer-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-columns-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
        <ul class="ai-footer-menu-{{ ai_gen_id }}">
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/search" class="ai-footer-menu-link-{{ ai_gen_id }}">Search</a>
          </li>
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/" class="ai-footer-menu-link-{{ ai_gen_id }}">Home</a>
          </li>
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/pages/about-us" class="ai-footer-menu-link-{{ ai_gen_id }}">About Us</a>
          </li>
        </ul>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
        <ul class="ai-footer-menu-{{ ai_gen_id }}">
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/pages/privacy-policy" class="ai-footer-menu-link-{{ ai_gen_id }}">Privacy and Policies</a>
          </li>
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/pages/refund-policy" class="ai-footer-menu-link-{{ ai_gen_id }}">Return & Refund</a>
          </li>
          <li class="ai-footer-menu-item-{{ ai_gen_id }}">
            <a href="/pages/shipping-policy" class="ai-footer-menu-link-{{ ai_gen_id }}">Shipping Policy</a>
          </li>
        </ul>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
        <p class="ai-footer-newsletter-description-{{ ai_gen_id }}">{{ block.settings.newsletter_description }}</p>
        
        {%- form 'contact' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ai-footer-newsletter-form-{{ ai_gen_id }}">
            <div class="ai-footer-newsletter-input-wrapper-{{ ai_gen_id }}">
              <input
                type="email"
                name="contact[email]"
                class="ai-footer-newsletter-input-{{ ai_gen_id }}"
                value="{{ form.email }}"
                placeholder="{{ block.settings.email_placeholder }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ai-footer-newsletter-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="ai-footer-newsletter-success-{{ ai_gen_id }}"
                {% endif %}
                required
              >
              <button type="submit" class="ai-footer-newsletter-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </button>
            </div>
            
            {%- if form.errors -%}
              <p id="ai-footer-newsletter-error-{{ ai_gen_id }}" class="ai-footer-newsletter-message-{{ ai_gen_id }} ai-footer-newsletter-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            
            {%- if form.posted_successfully? -%}
              <p id="ai-footer-newsletter-success-{{ ai_gen_id }}" class="ai-footer-newsletter-message-{{ ai_gen_id }} ai-footer-newsletter-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</footer-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('footer-block-{{ ai_gen_id }}', FooterBlock{{ ai_gen_id }});
  })();
</script>

