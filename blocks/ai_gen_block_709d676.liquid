{% doc %}
  @prompt
    Add a dynamic section on the product page that displays all other products below the currently selected product.
    Requirements:
    The section should appear when the user scrolls below the main product details.
    Display a grid of products (3–4 per row on desktop, responsive on mobile).
    Exclude the currently viewed product from the list.
    Show product image, name, price, and a “View Product” or “Add to Cart” button.
    Preferably show products from the same collection or category.
    Add a heading like “You May Also Like” or “Explore More Products”.
    Ensure clean UI/UX with proper spacing, hover effects, and mobile responsiveness.
    Use existing theme styles and components for consistency.
    Optional enhancements:
    Add horizontal scrolling on mobile
    Add quick add-to-cart button
    Lazy loading for performance
    add animation same as featured collection, it is not a recommedation panel here you have to show all the products , why the product images not visible, prices also and why it is showing all the products are sold out, images are not visible, can you change the color scheme to scheme 4, change button border to white color, why it is not showing the original price of the products, the price is not original which i have saved 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-all-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-all-products__container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-all-products__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-all-products__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-all-products__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-all-products__grid-{{ ai_gen_id }}.ai-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_thickness }}px solid rgba(255, 255, 255, {{ block.settings.card_border_opacity | divided_by: 100.0 }});
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .ai-product-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 100%;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-card__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-product-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-product-card__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 12px;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-product-card__title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card__title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-product-card__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: rgba(255, 255, 255, 0.5);
    margin-right: 8px;
    font-size: 14px;
  }

  .ai-product-card__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-card__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease, border-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-product-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-product-card__quick-add-{{ ai_gen_id }} {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 44px;
    height: 44px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    z-index: 3;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card__quick-add-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .ai-product-card__quick-add-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-all-products__load-more-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-all-products__load-more-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease, border-color 0.3s ease;
  }

  .ai-all-products__load-more-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-all-products__load-more-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-all-products__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-all-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-all-products__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-all-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      {% if block.settings.enable_mobile_scroll %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 16px;
        padding-bottom: 16px;
        -webkit-overflow-scrolling: touch;
      {% endif %}
    }

    {% if block.settings.enable_mobile_scroll %}
      .ai-product-card-{{ ai_gen_id }} {
        flex: 0 0 75%;
        scroll-snap-align: start;
      }
    {% endif %}

    .ai-all-products__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-product-card__quick-add-{{ ai_gen_id }} {
      opacity: 1;
      transform: scale(1);
    }
  }
{% endstyle %}

<all-products-display-{{ ai_gen_id }}
  class="ai-all-products-{{ ai_gen_id }}"
  data-current-product-id="{{ product.id }}"
  data-collection-handle="{{ block.settings.collection.handle }}"
  data-products-per-page="{{ block.settings.products_per_page }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-all-products__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-all-products__header-{{ ai_gen_id }}">
        <h2 class="ai-all-products__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-all-products__grid-{{ ai_gen_id }}" data-grid></div>

    {% if block.settings.enable_load_more %}
      <div class="ai-all-products__load-more-{{ ai_gen_id }}" data-load-more-container style="display: none;">
        <button class="ai-all-products__load-more-button-{{ ai_gen_id }}" data-load-more-button>
          Load More Products
        </button>
      </div>
    {% endif %}
  </div>
</all-products-display-{{ ai_gen_id }}>

<script>
  (function() {
    class AllProductsDisplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentProductId = this.dataset.currentProductId;
        this.collectionHandle = this.dataset.collectionHandle || '';
        this.productsPerPage = parseInt(this.dataset.productsPerPage) || 12;
        this.grid = this.querySelector('[data-grid]');
        this.loadMoreButton = this.querySelector('[data-load-more-button]');
        this.loadMoreContainer = this.querySelector('[data-load-more-container]');
        this.enableQuickAdd = {{ block.settings.enable_quick_add | json }};
        this.showVendor = {{ block.settings.show_vendor | json }};
        this.showComparePrice = {{ block.settings.show_compare_price | json }};
        this.enableAnimation = {{ block.settings.enable_animation | json }};
        this.enableLoadMore = {{ block.settings.enable_load_more | json }};
        this.currentPage = 1;
        this.allProducts = [];
        this.displayedProducts = [];
      }

      connectedCallback() {
        this.fetchAllProducts();
        if (this.loadMoreButton) {
          this.loadMoreButton.addEventListener('click', () => this.loadMoreProducts());
        }
        if (this.enableAnimation) {
          this.setupScrollAnimation();
        }
      }

      async fetchAllProducts() {
        try {
          this.grid.innerHTML = '<div class="ai-all-products__empty-{{ ai_gen_id }}">Loading products...</div>';
          
          let url;
          if (this.collectionHandle) {
            url = `/collections/${this.collectionHandle}/products.json?limit=250`;
          } else {
            url = '/products.json?limit=250';
          }

          const response = await fetch(url);
          
          if (!response.ok) throw new Error('Failed to fetch products');
          
          const data = await response.json();
          
          this.allProducts = data.products.filter(p => p.id.toString() !== this.currentProductId);
          
          if (this.allProducts.length > 0) {
            this.displayProducts();
          } else {
            this.grid.innerHTML = '<div class="ai-all-products__empty-{{ ai_gen_id }}">No other products available.</div>';
          }
        } catch (error) {
          console.error('Error fetching products:', error);
          this.grid.innerHTML = '<div class="ai-all-products__empty-{{ ai_gen_id }}">Unable to load products.</div>';
        }
      }

      displayProducts() {
        const startIndex = (this.currentPage - 1) * this.productsPerPage;
        const endIndex = startIndex + this.productsPerPage;
        const productsToShow = this.allProducts.slice(0, endIndex);
        
        this.grid.innerHTML = productsToShow.map(product => this.createProductCard(product)).join('');
        
        if (this.enableAnimation) {
          setTimeout(() => {
            this.grid.classList.add('ai-visible-{{ ai_gen_id }}');
          }, 100);
        } else {
          this.grid.classList.add('ai-visible-{{ ai_gen_id }}');
        }

        if (this.enableQuickAdd) {
          this.setupQuickAddButtons();
        }

        if (this.enableLoadMore && this.loadMoreContainer) {
          if (endIndex < this.allProducts.length) {
            this.loadMoreContainer.style.display = 'block';
            this.loadMoreButton.disabled = false;
          } else {
            this.loadMoreContainer.style.display = 'none';
          }
        }
      }

      loadMoreProducts() {
        this.currentPage++;
        this.loadMoreButton.disabled = true;
        this.loadMoreButton.textContent = 'Loading...';
        
        setTimeout(() => {
          this.displayProducts();
          this.loadMoreButton.textContent = 'Load More Products';
        }, 300);
      }

      createProductCard(product) {
        const variant = product.variants && product.variants[0] ? product.variants[0] : null;
        const variantId = variant ? variant.id : product.id;
        
        const price = variant && variant.price !== undefined ? variant.price : 0;
        const comparePrice = variant && variant.compare_at_price !== undefined ? variant.compare_at_price : null;
        
        const isOnSale = comparePrice && parseFloat(comparePrice) > parseFloat(price);
        const hasComparePrice = this.showComparePrice && isOnSale;
        const isAvailable = variant ? (variant.available !== false) : true;
        
        let imageUrl = null;
        if (product.images && product.images.length > 0) {
          imageUrl = typeof product.images[0] === 'string' ? product.images[0] : product.images[0].src;
        } else if (product.image) {
          imageUrl = typeof product.image === 'string' ? product.image : product.image.src;
        }
        
        const productUrl = `/products/${product.handle}`;
        
        return `
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-card__image-wrapper-{{ ai_gen_id }}">
              ${imageUrl ? `
                <img
                  src="${imageUrl}"
                  alt="${this.escapeHtml(product.title)}"
                  class="ai-product-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              ` : `
                <div class="ai-product-card__image-{{ ai_gen_id }}" style="background-color: #1a1a1a; display: flex; align-items: center; justify-content: center; color: #666;">No Image</div>
              `}
              ${isOnSale ? `<span class="ai-product-card__badge-{{ ai_gen_id }}">Sale</span>` : ''}
              ${!isAvailable ? `<span class="ai-product-card__badge-{{ ai_gen_id }}" style="background-color: #666;">Sold Out</span>` : ''}
              ${this.enableQuickAdd && isAvailable ? `
                <button
                  class="ai-product-card__quick-add-{{ ai_gen_id }}"
                  data-variant-id="${variantId}"
                  aria-label="Quick add ${this.escapeHtml(product.title)}"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </button>
              ` : ''}
            </div>
            <div class="ai-product-card__content-{{ ai_gen_id }}">
              ${this.showVendor && product.vendor ? `
                <div class="ai-product-card__vendor-{{ ai_gen_id }}">${this.escapeHtml(product.vendor)}</div>
              ` : ''}
              <h3 class="ai-product-card__title-{{ ai_gen_id }}">
                <a href="${productUrl}" class="ai-product-card__title-link-{{ ai_gen_id }}">
                  ${this.escapeHtml(product.title)}
                </a>
              </h3>
              <div class="ai-product-card__price-{{ ai_gen_id }}">
                ${hasComparePrice ? `
                  <span class="ai-product-card__price-compare-{{ ai_gen_id }}">
                    ${this.formatMoney(comparePrice)}
                  </span>
                ` : ''}
                <span class="${isOnSale ? 'ai-product-card__price-sale-{{ ai_gen_id }}' : ''}">
                  ${this.formatMoney(price)}
                </span>
              </div>
              <a href="${productUrl}" class="ai-product-card__button-{{ ai_gen_id }}">
                ${isAvailable ? 'View Product' : 'Sold Out'}
              </a>
            </div>
          </div>
        `;
      }

      setupQuickAddButtons() {
        const buttons = this.querySelectorAll('.ai-product-card__quick-add-{{ ai_gen_id }}');
        buttons.forEach(button => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const variantId = button.dataset.variantId;
            this.quickAddToCart(variantId, button);
          });
        });
      }

      async quickAddToCart(variantId, button) {
        const originalContent = button.innerHTML;
        button.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" opacity="0.3"/></svg>';
        button.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (!response.ok) throw new Error('Failed to add to cart');

          button.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10L8 14L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
          
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          
          setTimeout(() => {
            button.innerHTML = originalContent;
            button.disabled = false;
          }, 2000);
        } catch (error) {
          console.error('Error adding to cart:', error);
          button.innerHTML = originalContent;
          button.disabled = false;
        }
      }

      setupScrollAnimation() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.grid.classList.add('ai-visible-{{ ai_gen_id }}');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -100px 0px'
        });

        observer.observe(this.grid);
      }

      formatMoney(amount) {
        if (amount === null || amount === undefined || amount === '') return '';
        const numAmount = parseFloat(amount);

        const currency = window.Shopify?.currency?.active || 'USD';
        const locale = window.Shopify?.locale || 'en-US';

        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency: currency,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(numAmount);
      }

      escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('all-products-display-{{ ai_gen_id }}', AllProductsDisplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "All products display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Explore More Products"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products from the store"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "info": "Number of products to show initially"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Enable load more button",
      "default": true,
      "info": "Show a button to load more products"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_scroll",
      "label": "Enable horizontal scroll on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add button",
      "default": true,
      "info": "Shows a quick add to cart button on hover"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable scroll animation",
      "default": true,
      "info": "Products fade in when scrolled into view"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
