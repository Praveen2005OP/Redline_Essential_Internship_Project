{% doc %}
  @prompt
    <div style="background-color: #000000; padding: 60px 20px; text-align: center; font-family: sans-serif;">
      
      <h2 style="color: #ffffff; font-size: 36px; font-weight: bold; margin-bottom: 60px; letter-spacing: 1px;">The Redline Standard</h2>
      
      <div style="display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; max-width: 1200px; margin: 0 auto;">
        
        <div style="flex: 1; min-width: 250px; max-width: 350px; display: flex; flex-direction: column; align-items: center;">
          <div style="margin-bottom: 25px; color: #ffffff;">
            <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h3 style="color: #ffffff; font-size: 18px; font-weight: 600; margin-bottom: 15px; letter-spacing: 0.5px;">Premium Quality</h3>
          <p style="color: #a3a3a3; font-size: 15px; line-height: 1.6; margin: 0;">Genuine, high-performance components engineered for perfect fitment and aggressive styling.</p>
        </div>
    
        <div style="flex: 1; min-width: 250px; max-width: 350px; display: flex; flex-direction: column; align-items: center;">
          <div style="margin-bottom: 25px; color: #ffffff;">
            <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <h3 style="color: #ffffff; font-size: 18px; font-weight: 600; margin-bottom: 15px; letter-spacing: 0.5px;">Fast & Secure Shipping</h3>
          <p style="color: #a3a3a3; font-size: 15px; line-height: 1.6; margin: 0;">Tracked, insured delivery on all orders to ensure your upgrades arrive safely and on time.</p>
        </div>
    
        <div style="flex: 1; min-width: 250px; max-width: 350px; display: flex; flex-direction: column; align-items: center;">
          <div style="margin-bottom: 25px; color: #ffffff;">
            <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 style="color: #ffffff; font-size: 18px; font-weight: 600; margin-bottom: 15px; letter-spacing: 0.5px;">Secure Checkout</h3>
          <p style="color: #a3a3a3; font-size: 15px; line-height: 1.6; margin: 0;">Shop with absolute confidence using our 100% encrypted payment gateway and 30-day return policy.</p>
        </div>
    
      </div>
    </div>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-features-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    letter-spacing: 1px;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.grid_gap }}px;
    flex-wrap: wrap;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    flex: 1;
    min-width: {{ block.settings.item_min_width }}px;
    max-width: {{ block.settings.item_max_width }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-feature-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    letter-spacing: 0.5px;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-features-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.5 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-features-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-features-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-feature-item-{{ ai_gen_id }} {
      min-width: 100%;
    }

    .ai-feature-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<redline-features-{{ ai_gen_id }} class="ai-features-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-features-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

