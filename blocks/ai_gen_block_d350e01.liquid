<script>
  (function() {
    class RedlineFeatures{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('redline-features-{{ ai_gen_id }}', RedlineFeatures{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
