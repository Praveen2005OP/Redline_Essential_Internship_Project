{% doc %}
  @prompt
    Add a dynamic section on the product page that displays all other products below the currently selected product.
    Requirements:
    The section should appear when the user scrolls below the main product details.
    Display a grid of products (3–4 per row on desktop, responsive on mobile).
    Exclude the currently viewed product from the list.
    Show product image, name, price, and a “View Product” or “Add to Cart” button.
    Preferably show products from the same collection or category.
    Add a heading like “You May Also Like” or “Explore More Products”.
    Ensure clean UI/UX with proper spacing, hover effects, and mobile responsiveness.
    Use existing theme styles and components for consistency.
    Optional enhancements:
    Add horizontal scrolling on mobile
    Add quick add-to-cart button
    Lazy loading for performance
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-recommendations-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-recommendations__container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-recommendations__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-product-recommendations__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-product-recommendations__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin-top: 8px;
  }

  .ai-product-recommendations__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ settings.spacing_grid_vertical }}px {{ settings.spacing_grid_horizontal }}px;
    margin-top: 20px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ settings.card_corner_radius }}px;
    border: {{ settings.card_border_thickness }}px solid rgba(0, 0, 0, {{ settings.card_border_opacity | divided_by: 100.0 }});
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if settings.card_shadow_opacity > 0 %}
      box-shadow: {{ settings.card_shadow_horizontal_offset }}px {{ settings.card_shadow_vertical_offset }}px {{ settings.card_shadow_blur }}px rgba(0, 0, 0, {{ settings.card_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    {% if settings.card_shadow_opacity > 0 %}
      box-shadow: {{ settings.card_shadow_horizontal_offset }}px {{ settings.card_shadow_vertical_offset | plus: 4 }}px {{ settings.card_shadow_blur | plus: 5 }}px rgba(0, 0, 0, {{ settings.card_shadow_opacity | divided_by: 100.0 | plus: 0.1 }});
    {% endif %}
  }

  .ai-product-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-card__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 12px;
    border-radius: {{ settings.badge_corner_radius }}px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-product-card__content-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-card__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-product-card__title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card__title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 12px;
    font-weight: 600;
  }

  .ai-product-card__price--compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
    font-weight: 400;
  }

  .ai-product-card__price--sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-card__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ settings.buttons_border_thickness }}px solid {{ block.settings.button_background }};
    border-radius: {{ settings.buttons_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    margin-top: auto;
  }

  .ai-product-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-product-card__quick-add-{{ ai_gen_id }} {
    margin-top: 8px;
    padding: 10px 20px;
    background-color: transparent;
    color: {{ block.settings.button_background }};
    border: {{ settings.buttons_border_thickness }}px solid {{ block.settings.button_background }};
    border-radius: {{ settings.buttons_radius }}px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .ai-product-card__quick-add-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-product-recommendations__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  .ai-product-recommendations__loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  @media screen and (max-width: 989px) {
    .ai-product-recommendations__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-recommendations__grid-{{ ai_gen_id }} {
      {% if block.settings.enable_mobile_scroll %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 12px;
        padding-bottom: 10px;
        -webkit-overflow-scrolling: touch;
      {% else %}
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      {% endif %}
    }

    {% if block.settings.enable_mobile_scroll %}
      .ai-product-card-{{ ai_gen_id }} {
        flex: 0 0 75%;
        scroll-snap-align: start;
      }
    {% endif %}

    .ai-product-recommendations__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-product-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<product-recommendations-{{ ai_gen_id }}
  class="ai-product-recommendations-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ block.settings.products_to_show }}"
  data-intent="{{ block.settings.recommendation_intent }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-recommendations__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-product-recommendations__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-recommendations__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-product-recommendations__subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-recommendations__loading-{{ ai_gen_id }}">
      Loading recommendations...
    </div>

    <div class="ai-product-recommendations__grid-{{ ai_gen_id }}" style="display: none;">
    </div>
  </div>
</product-recommendations-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductRecommendations{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
        this.limit = this.dataset.limit || 4;
        this.intent = this.dataset.intent || 'related';
      }

      connectedCallback() {
        this.fetchRecommendations();
      }

      async fetchRecommendations() {
        try {
          const response = await fetch(
            `/recommendations/products.json?product_id=${this.productId}&limit=${this.limit}&intent=${this.intent}`
          );
          
          if (!response.ok) {
            throw new Error('Failed to fetch recommendations');
          }

          const data = await response.json();
          this.renderProducts(data.products);
        } catch (error) {
          console.error('Error fetching product recommendations:', error);
          this.showEmpty();
        }
      }

      renderProducts(products) {
        const loadingEl = this.querySelector('.ai-product-recommendations__loading-{{ ai_gen_id }}');
        const gridEl = this.querySelector('.ai-product-recommendations__grid-{{ ai_gen_id }}');

        if (loadingEl) {
          loadingEl.style.display = 'none';
        }

        if (!products || products.length === 0) {
          this.showEmpty();
          return;
        }

        gridEl.innerHTML = products.map(product => this.createProductCard(product)).join('');
        gridEl.style.display = 'grid';

        {% if block.settings.enable_mobile_scroll %}
          if (window.innerWidth <= 749) {
            gridEl.style.display = 'flex';
          }
        {% endif %}

        this.attachQuickAddListeners();
      }

      createProductCard(product) {
        const showVendor = {{ block.settings.show_vendor }};
        const showQuickAdd = {{ block.settings.show_quick_add }};
        const buttonText = {{ block.settings.button_text | json }};
        const quickAddText = {{ block.settings.quick_add_text | json }};
        
        const price = this.formatMoney(product.price);
        const comparePrice = product.compare_at_price > product.price 
          ? this.formatMoney(product.compare_at_price) 
          : null;
        
        const isOnSale = product.compare_at_price > product.price;
        const isSoldOut = !product.available;

        let badgeHtml = '';
        if (isSoldOut) {
          badgeHtml = '<span class="ai-product-card__badge-{{ ai_gen_id }}">Sold Out</span>';
        } else if (isOnSale) {
          badgeHtml = '<span class="ai-product-card__badge-{{ ai_gen_id }}">Sale</span>';
        }

        return `
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-card__image-wrapper-{{ ai_gen_id }}">
              ${badgeHtml}
              <img
                src="${product.featured_image}"
                alt="${this.escapeHtml(product.title)}"
                class="ai-product-card__image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            </div>
            <div class="ai-product-card__content-{{ ai_gen_id }}">
              ${showVendor && product.vendor ? `<div class="ai-product-card__vendor-{{ ai_gen_id }}">${this.escapeHtml(product.vendor)}</div>` : ''}
              <h3 class="ai-product-card__title-{{ ai_gen_id }}">
                <a href="${product.url}" class="ai-product-card__title-link-{{ ai_gen_id }}">
                  ${this.escapeHtml(product.title)}
                </a>
              </h3>
              <div class="ai-product-card__price-{{ ai_gen_id }}">
                ${comparePrice ? `<span class="ai-product-card__price--compare-{{ ai_gen_id }}">${comparePrice}</span>` : ''}
                <span class="${isOnSale ? 'ai-product-card__price--sale-{{ ai_gen_id }}' : ''}">${price}</span>
              </div>
              <a href="${product.url}" class="ai-product-card__button-{{ ai_gen_id }}">
                ${buttonText}
              </a>
              ${showQuickAdd && !isSoldOut ? `
                <button 
                  class="ai-product-card__quick-add-{{ ai_gen_id }}"
                  data-product-id="${product.id}"
                  data-variant-id="${product.variants[0].id}"
                >
                  ${quickAddText}
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }

      attachQuickAddListeners() {
        const quickAddButtons = this.querySelectorAll('.ai-product-card__quick-add-{{ ai_gen_id }}');
        quickAddButtons.forEach(button => {
          button.addEventListener('click', (e) => this.handleQuickAdd(e));
        });
      }

      async handleQuickAdd(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;
        const originalText = button.textContent;

        button.textContent = 'Adding...';
        button.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';
          
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));
          
          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }

      showEmpty() {
        const loadingEl = this.querySelector('.ai-product-recommendations__loading-{{ ai_gen_id }}');
        const gridEl = this.querySelector('.ai-product-recommendations__grid-{{ ai_gen_id }}');
        
        if (loadingEl) {
          loadingEl.style.display = 'none';
        }

        {% if block.settings.hide_if_empty %}
          this.style.display = 'none';
        {% else %}
          const emptyMessage = {{ block.settings.empty_message | json }};
          gridEl.innerHTML = `<div class="ai-product-recommendations__empty-{{ ai_gen_id }}">${emptyMessage}</div>`;
          gridEl.style.display = 'block';
        {% endif %}
      }

      formatMoney(cents) {
        const amount = cents / 100;
        {% if settings.currency_code_enabled %}
          return new Intl.NumberFormat('{{ localization.language.iso_code }}', {
            style: 'currency',
            currency: '{{ cart.currency.iso_code }}'
          }).format(amount);
        {% else %}
          return new Intl.NumberFormat('{{ localization.language.iso_code }}', {
            style: 'currency',
            currency: '{{ cart.currency.iso_code }}',
            currencyDisplay: 'symbol'
          }).format(amount);
        {% endif %}
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('product-recommendations-{{ ai_gen_id }}', ProductRecommendations{{ ai_gen_id }});
  })();
</script>

