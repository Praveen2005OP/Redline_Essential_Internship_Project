{% doc %}
  @prompt
    discount on first order to attract customers
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-first-order-discount-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-first-order-discount__container-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    text-align: center;
    overflow: hidden;
  }

  .ai-first-order-discount__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .ai-first-order-discount__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-first-order-discount__discount-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_size }}px;
    color: {{ block.settings.discount_color }};
    font-weight: 800;
    margin: 16px 0;
    line-height: 1;
  }

  .ai-first-order-discount__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-first-order-discount__code-wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-first-order-discount__code-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background }};
    color: {{ block.settings.code_text_color }};
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    border: 2px dashed {{ block.settings.code_border_color }};
  }

  .ai-first-order-discount__copy-btn-{{ ai_gen_id }} {
    background-color: {{ block.settings.copy_button_color }};
    color: {{ block.settings.copy_button_text_color }};
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-first-order-discount__copy-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.copy_button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-first-order-discount__cta-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.cta_button_color }};
    color: {{ block.settings.cta_button_text_color }};
    padding: 16px 40px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-first-order-discount__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-first-order-discount__terms-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.terms_color }};
    margin-top: 16px;
    opacity: 0.8;
  }

  .ai-first-order-discount__copied-{{ ai_gen_id }} {
    position: fixed;
    top: 20px;
    right: 20px;
    background-color: #008060;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 9999;
  }

  .ai-first-order-discount__copied-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  @media screen and (max-width: 749px) {
    .ai-first-order-discount__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-first-order-discount__discount-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.discount_size }}px * 0.7);
    }

    .ai-first-order-discount__code-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .ai-first-order-discount__code-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }
{% endstyle %}

<first-order-discount-{{ ai_gen_id }}
  class="ai-first-order-discount-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-first-order-discount__container-{{ ai_gen_id }}">
    {% if block.settings.show_badge %}
      <div class="ai-first-order-discount__badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-first-order-discount__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.discount_text != blank %}
      <div class="ai-first-order-discount__discount-{{ ai_gen_id }}">
        {{ block.settings.discount_text }}
      </div>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-first-order-discount__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {% if block.settings.discount_code != blank %}
      <div class="ai-first-order-discount__code-wrapper-{{ ai_gen_id }}">
        <div class="ai-first-order-discount__code-{{ ai_gen_id }}" data-code="{{ block.settings.discount_code }}">
          {{ block.settings.discount_code }}
        </div>
        <button
          class="ai-first-order-discount__copy-btn-{{ ai_gen_id }}"
          data-copy-button
          aria-label="Copy discount code"
        >
          {{ block.settings.copy_button_text }}
        </button>
      </div>
    {% endif %}

    {% if block.settings.cta_button_text != blank and block.settings.cta_button_link != blank %}
      <a
        href="{{ block.settings.cta_button_link }}"
        class="ai-first-order-discount__cta-{{ ai_gen_id }}"
      >
        {{ block.settings.cta_button_text }}
      </a>
    {% endif %}

    {% if block.settings.terms_text != blank %}
      <div class="ai-first-order-discount__terms-{{ ai_gen_id }}">
        {{ block.settings.terms_text }}
      </div>
    {% endif %}
  </div>

  <div class="ai-first-order-discount__copied-{{ ai_gen_id }}" data-copied-message>
    Code copied!
  </div>
</first-order-discount-{{ ai_gen_id }}>

<script>
  (function() {
    class FirstOrderDiscount{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.copyButton = this.querySelector('[data-copy-button]');
        this.codeElement = this.querySelector('.ai-first-order-discount__code-{{ ai_gen_id }}');
        this.copiedMessage = this.querySelector('[data-copied-message]');

        if (this.copyButton && this.codeElement) {
          this.copyButton.addEventListener('click', this.handleCopy.bind(this));
        }
      }

      handleCopy() {
        const code = this.codeElement.getAttribute('data-code');

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(() => {
            this.showCopiedMessage();
          }).catch(() => {
            this.fallbackCopy(code);
          });
        } else {
          this.fallbackCopy(code);
        }
      }

      fallbackCopy(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        document.body.appendChild(textArea);
        textArea.select();

        try {
          document.execCommand('copy');
          this.showCopiedMessage();
        } catch (err) {
          console.error('Failed to copy text');
        }

        document.body.removeChild(textArea);
      }

      showCopiedMessage() {
        this.copiedMessage.classList.add('active');

        setTimeout(() => {
          this.copiedMessage.classList.remove('active');
        }, 2000);
      }
    }

    customElements.define('first-order-discount-{{ ai_gen_id }}', FirstOrderDiscount{{ ai_gen_id }});
  })();
</script>

